    <!-- 关于 -->
    <string name="about_title">关于</string>
    <string name="about_desc">版本信息、隐私说明，以及本应用所使用的开源组件。</string>
    <string name="about_version">版本 %1$s（构建号 %2$d）</string>
    <string name="about_privacy_title">隐私说明</string>
    <string name="about_privacy_ai">使用 AI 图片处理功能时，所选照片会上传至设置中配置的接口，并在该服务端完成处理。Grok 订阅模式下，照片与指令发往 xAI 的固定地址 api.x.ai，而不是设置中填写的地址。不使用 AI 功能时，照片不会上传。</string>
    <string name="about_privacy_ftp">相机 FTP 服务运行期间会在局域网内开放监听端口。同一网络中知晓账号的人均可向本机上传照片。不使用时请停止该服务。</string>
    <string name="about_privacy_storage">API 密钥与 FTP 密码保存在本机的加密存储中，除发送至您所配置的接口外不会外传。Grok 订阅登录在浏览器中向 xAI 授权，所得令牌加密保存在本机，不参与备份与设备迁移，只发送给 xAI 的登录与图片接口。</string>
    <string name="about_privacy_local">照片、编辑结果与活动日志仅保存在本机。</string>
    <string name="about_policy_title">隐私政策</string>
    <string name="about_policy_placeholder">待补充正式隐私政策链接，需由产品方在应用上架前提供。</string>
    <string name="about_licenses_title">开源许可</string>
    <string name="about_licenses_desc">本应用包含以下第三方组件。</string>

